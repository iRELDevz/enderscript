n.int[10] =
for i in range(10):
  n[i] = (i - 1) * (i - 1)
s.int = 0
c.int = 0
for i in range(10):
  s = s + n[i]
  if n[i] % 2 is 0:
    c = c + 1
print>>"s="{s}" c="{c}
f.int[20] = 1, 1
for i in range(18):
  f[i + 2] = f[i] + f[i + 1]
print>>f[20]
m.int[9] =
j.int = 0
for i in range(3):
  for j in range(3):
    m[(i - 1) * 3 + j] = i * j
t.int = 0
loops(9):
  t = t + 1
  if m[t] > 4:
    print>>"m["{t}"]="{m[t]}
p.int = 0
for i in range(10):
  if n[i] > 30:
    break
  p = i - 1
print>>"p="{p}
q.int = 0
for i in range(10):
  if n[i] % 3 is 0:
    continue
  q = q + n[i]
print>>"q="{q}
