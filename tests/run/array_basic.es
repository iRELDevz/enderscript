nilai.int[5] = 10, 20, 30
print>>nilai[1]
print>>nilai[3]
print>>nilai[5]
print>>"len = "{nilai.len}
nilai[2] = 99
nilai[5] = nilai[1] + nilai[2]
print>>"a "{nilai[2]}" b "{nilai[5]}
s.int = 0
for i in range(nilai.len):
  s = s + nilai[i]
print>>"jumlah = "{s}
aktif.bool[4] = true
print>>aktif[1]
print>>aktif[2]
semua.bool[3] = true.all
print>>{semua[1]}" "{semua[2]}" "{semua[3]}
nama.str[3] = "Andi", 'Budi'
print>>nama[1]
print>>nama[2]
print>>nama[3]
nama[3] = "Citra"
k.int = 3
print>>"ketiga: "{nama[k]}
if nama[1] is "Andi":
  print>>"ya"
if nama[k] is nama[3]:
  print>>"sama"
if aktif[1] is aktif[2]:
  print>>"salah"
else:
  print>>"beda"
x.str = nama[2]
print>>x
b.bool = semua[2]
print>>b
z.int = nilai[k] * 2
print>>z
